[Unit]
Description=Zenith Pharma — Mise à jour automatique nocturne
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/zenith-pharma/nightly-update.sh
WorkingDirectory=/opt/zenith-pharma
User=root
# BUILD_TIMEOUT=900 dans nightly-update.sh (x2 retries possibles) + marge :
# le service ne doit pas tuer la MAJ en vol avant la fin du build.
TimeoutStartSec=1800
